{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QCB result audit",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "generated_at",
    "passed",
    "result_file",
    "rows",
    "model_ids",
    "lanes",
    "suites",
    "seeds",
    "expected_tasks",
    "expected_pairs",
    "actual_unique_pairs",
    "duplicates",
    "missing",
    "unexpected",
    "hash_statuses",
    "errors",
    "warnings"
  ],
  "properties": {
    "passed": {
      "type": "boolean"
    },
    "rows": {
      "type": "integer",
      "minimum": 0
    },
    "expected_pairs": {
      "type": "integer",
      "minimum": 0
    },
    "actual_unique_pairs": {
      "type": "integer",
      "minimum": 0
    },
    "duplicates": {
      "type": "array"
    },
    "missing": {
      "type": "array"
    },
    "unexpected": {
      "type": "array"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
