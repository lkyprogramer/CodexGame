{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QCB quality-gated leaderboard",
  "type": "object",
  "additionalProperties": true,
  "required": ["generated_at", "lane", "suite", "quality_gate", "models", "pairwise"],
  "properties": {
    "lane": {"enum": ["normalized", "optimized"]},
    "models": {"type": "array", "minItems": 1},
    "pairwise": {"type": "array"}
  }
}
