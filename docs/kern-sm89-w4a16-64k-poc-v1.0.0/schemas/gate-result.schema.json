{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kern SM89 GPU task gate result (generated by the implementation, not this kit)",
  "type": "object",
  "required": [
    "id",
    "status",
    "command",
    "exit_code",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "INCOMPLETE",
        "NOT_RUN"
      ]
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "details": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
