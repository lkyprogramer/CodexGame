# Copy to configs/benchmark.env and edit if needed.
SERVER_URL=http://127.0.0.1:18020
MODEL_ID=qwen3.8-27b
API_KEY=local-qwen-bench

# Pi executable already installed on the host.
PI_BIN=pi
PI_PROVIDER=local-vllm
PI_MODEL=qwen3.8-27b-local
PI_THINKING=medium
PI_CASE_TIMEOUT_SEC=480

# Suite hard cap.
SUITE_TIMEOUT_SEC=3600

# HTTP benchmark sizes. These are requested actual-token targets; /tokenize is used when available.
SHORT_PROMPT_TOKENS=4096
MID_PROMPT_TOKENS=64000
LONG_PROMPT_TOKENS=120000
DEEP_PROMPT_TOKENS=185000
CACHE_PROMPT_TOKENS=100000

# Completion budgets.
SHORT_OUTPUT_TOKENS=768
MID_OUTPUT_TOKENS=512
LONG_OUTPUT_TOKENS=384
DEEP_OUTPUT_TOKENS=256

# Optional: set QUICK_ONLY=1 when invoking run_all.sh for smoke only.
