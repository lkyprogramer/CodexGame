{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Documentation helper validation report",
  "type": "object",
  "required": [
    "status",
    "errors",
    "warnings",
    "counts"
  ],
  "properties": {
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "additionalProperties": false
}
