{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NInfer frontend benchmark normalized row v1",
  "type": "object",
  "required": [
    "schema_version",
    "pair_id",
    "session_id",
    "mode",
    "input_sha256",
    "resources_sha256",
    "prompt_tokens",
    "cache_kind",
    "cohort",
    "tokenize_seconds",
    "status",
    "oracle_match"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pair_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "legacy",
        "single-pass",
        "incremental"
      ]
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resources_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prompt_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "cache_kind": {
      "enum": [
        "cold",
        "warm",
        "none"
      ]
    },
    "cohort": {
      "enum": [
        "synthetic",
        "replay",
        "live"
      ]
    },
    "tokenize_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "prepare_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "ttft_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "decode_tps": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "status": {
      "enum": [
        "ok",
        "error",
        "cancelled",
        "rejected"
      ]
    },
    "oracle_match": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "render_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "boundary_queries": {
      "type": "integer",
      "minimum": 0
    },
    "reused_prefix_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "suffix_input_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "tokenize_seconds": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  ]
}
