{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline fixture measurement",
  "type": "object",
  "required": [
    "case_id",
    "input_sha256",
    "resources_sha256",
    "prompt_tokens",
    "render_bytes",
    "checkpoint_hints",
    "boundary_queries"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resources_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prompt_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "render_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "checkpoint_hints": {
      "type": "integer",
      "minimum": 0
    },
    "boundary_queries": {
      "type": "integer",
      "minimum": 0
    }
  }
}
