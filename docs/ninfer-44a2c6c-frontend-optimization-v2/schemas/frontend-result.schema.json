{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized independent frontend outputs",
  "type": "object",
  "required": [
    "case_id",
    "input_sha256",
    "resources_sha256",
    "kind",
    "status"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resources_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "enum": [
        "raw",
        "rendered",
        "prepared",
        "count"
      ]
    },
    "status": {
      "enum": [
        "OK",
        "ERROR"
      ]
    },
    "semantic": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "required": [
        "phase",
        "class",
        "message"
      ],
      "properties": {
        "phase": {
          "type": "string"
        },
        "class": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ERROR"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      },
      "else": {
        "required": [
          "semantic"
        ]
      }
    }
  ],
  "description": "Semantic kind-specific required fields and exact pairing are additionally checked by tools/compare_frontend_results.py."
}
