{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Completed verification round only; abort-before-verify is a separate event",
  "type": "object",
  "required": [
    "round_ms",
    "proposed",
    "accepted",
    "licensed",
    "committed"
  ],
  "properties": {
    "round_ms": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "proposed": {
      "type": "integer",
      "minimum": 0
    },
    "accepted": {
      "type": "integer",
      "minimum": 0
    },
    "licensed": {
      "type": "integer",
      "minimum": 1
    },
    "committed": {
      "type": "integer",
      "minimum": 0
    },
    "profiled": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
