+// STRATA_VERIFY_ECAP (verify_kernels.hpp): one block, a thread per entry.  Every tail entry finds its rank by
+// (weight desc, index asc) in parallel; thread 0 walks the tail in that order against a bitmap of the kept experts,
+// then spreads the drops round robin over the fold targets (the kept experts in VRAM, else all kept ones - a single
+// target would pile the drops into one group, which upstream measured slower than the reads it saved); the barrier
+// hands every thread its verdict.  No atomics: the same routing gives the same result.
+__global__ void __launch_bounds__(kEcapMaxEntries) ecap_kernel(int32_t* __restrict__ ids, float* __restrict__ w, int n,
+                                                                int k, const int32_t* __restrict__ res, int n_expert,
+                                                                const volatile int32_t* cap_p) {
+    __shared__ float s_w[kEcapMaxEntries];
+    __shared__ int32_t s_id[kEcapMaxEntries];
+    __shared__ int32_t s_res[kEcapMaxEntries];   // per entry: its expert's VRAM slot; < 0 none (or no table)
+    __shared__ int s_order[kEcapMaxEntries];     // tail rank -> entry
+    __shared__ int32_t s_to[kEcapMaxEntries];    // per entry: -1 as routed, -2 dropped (no target yet), else the target
+    __shared__ int s_kept[kEcapMaxEntries];      // per kept expert, in the order kept: the entry that brought it in
+    __shared__ int32_t s_tgt[kEcapMaxEntries];   // the fold targets
+    __shared__ uint32_t s_bits[kEcapMaxExperts / 32];
+    __shared__ int s_cap;
+    const int tid = threadIdx.x;
+    if (tid == 0) s_cap = *cap_p;
+    __syncthreads();
+    const int cap = s_cap;
+    if (cap <= k || n <= k) return;   // uniform across the block: this window runs as routed (a prompt read: no other read)
+    for (int i = tid; i < kEcapMaxExperts / 32; i += blockDim.x) s_bits[i] = 0u;
+    if (tid < n) {
+        const int32_t e = ids[tid];
+        s_w[tid] = w[tid];
+        s_id[tid] = e;
+        s_res[tid] = res != nullptr && e >= 0 && e < n_expert ? res[e] : -1;   // every entry's in one round, not thread 0's
+        s_to[tid] = -1;
+    }
+    __syncthreads();
+    if (tid >= k && tid < n) {
+        const float wt = s_w[tid];
+        int r = 0;
+        for (int j = k; j < n; ++j) r += (s_w[j] > wt || (s_w[j] == wt && j < tid)) ? 1 : 0;
+        s_order[r] = tid;
+    }
+    __syncthreads();
+    if (tid == 0) {
+        int nk = 0, nd = 0;
+        for (int i = 0; i < k; ++i) {   // token 0: every pick kept
+            const int32_t e = s_id[i];
+            if (e < 0 || e >= n_expert || ((s_bits[e >> 5] >> (e & 31)) & 1u)) continue;
+            s_bits[e >> 5] |= 1u << (e & 31);
+            s_kept[nk++] = i;
+        }
+        for (int r = 0; r < n - k; ++r) {
+            const int j = s_order[r];
+            const int32_t e = s_id[j];
+            if (e < 0 || e >= n_expert || ((s_bits[e >> 5] >> (e & 31)) & 1u)) continue;   // read anyway: rides along
+            if (nk < cap) { s_bits[e >> 5] |= 1u << (e & 31); s_kept[nk++] = j; continue; }
+            s_to[j] = -2; ++nd;
+        }
+        if (nd > 0 && nk > 0) {
+            int nt = 0;
+            for (int i = 0; i < nk; ++i)
+                if (s_res[s_kept[i]] >= 0) s_tgt[nt++] = s_id[s_kept[i]];
+            if (nt == 0)
+                for (int i = 0; i < nk; ++i) s_tgt[nt++] = s_id[s_kept[i]];
+            int c = 0;
+            for (int j = k; j < n; ++j)
+                if (s_to[j] == -2) s_to[j] = s_tgt[c++ % nt];
+        }
+    }
+    __syncthreads();
+    if (tid < n && s_to[tid] >= 0) {
+        ids[tid] = s_to[tid];
+        w[tid] = 0.0f;
+    }
+}
