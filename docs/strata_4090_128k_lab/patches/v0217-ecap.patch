diff -ruN a/engine/src/kernels/ecap_parity.cpp b/engine/src/kernels/ecap_parity.cpp
--- /dev/null
+++ b/engine/src/kernels/ecap_parity.cpp
@@ -0,0 +1,142 @@
+// ecap_parity - STRATA_VERIFY_ECAP's expert cap against a scalar reference of the same semantics, bit for bit.
+//
+// `verify_ecap` rewrites a verify window's routing in place before the plan (CodexGame's port of upstream PR #3545,
+// capping the window's expert set): token 0 keeps all k picks; the tail, by (weight desc, index asc), keeps an entry
+// whose expert is already kept, keeps a new expert while fewer than `cap` distinct ones are, and drops the rest to
+// weight 0 and a kept expert's id (a resident one when there is one, round robin).  The committed position's
+// exactness and the plan's residency both hang on that, so this checks, on random windows shaped like the router
+// (512 experts, top-10, 2..12 tokens, some tied weights, a few invalid ids):
+//   * the kernel equals the reference exactly (ids and weights)
+//   * no cap (0, or not above k) and windows of one token: a no-op, bitwise
+//   * token 0 untouched; kept entries untouched; at most `cap` distinct valid experts; every dropped entry's weight
+//     exactly 0 and its id a kept expert's, a resident one whenever a kept expert is resident
+//   * the same input twice gives the same output
+#include "strata/kernels/verify_kernels.hpp"
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <set>
+#include <vector>
+
+namespace {
+void ck(cudaError_t e, const char* what) {
+    if (e != cudaSuccess) { std::fprintf(stderr, "%s: %s\n", what, cudaGetErrorString(e)); std::exit(2); }
+}
+
+// the semantics, written plainly
+void reference(std::vector<int32_t>& ids, std::vector<float>& w, int k, const std::vector<int32_t>& res, int n_expert, int cap) {
+    const int n = (int) ids.size();
+    if (cap <= k || n <= k) return;
+    std::vector<int> tail;
+    for (int j = k; j < n; ++j) tail.push_back(j);
+    std::stable_sort(tail.begin(), tail.end(), [&](int a, int b) { return w[a] > w[b]; });   // ties: index order
+    std::vector<int32_t> kept;
+    std::set<int32_t> in;
+    auto valid = [&](int32_t e) { return e >= 0 && e < n_expert; };
+    for (int i = 0; i < k; ++i)
+        if (valid(ids[i]) && in.insert(ids[i]).second) kept.push_back(ids[i]);
+    std::vector<int> dropped;
+    for (int j : tail) {
+        const int32_t e = ids[j];
+        if (!valid(e) || in.count(e)) continue;
+        if ((int) kept.size() < cap) { in.insert(e); kept.push_back(e); continue; }
+        dropped.push_back(j);
+    }
+    if (dropped.empty() || kept.empty()) return;
+    std::vector<int32_t> tgt;
+    for (int32_t e : kept) if (res[e] >= 0) tgt.push_back(e);
+    if (tgt.empty()) tgt = kept;
+    std::sort(dropped.begin(), dropped.end());
+    for (size_t i = 0; i < dropped.size(); ++i) { ids[dropped[i]] = tgt[i % tgt.size()]; w[dropped[i]] = 0.0f; }
+}
+}  // namespace
+
+int main() {
+    const int E = 512, K = 10;
+    int bad = 0, cases = 0;
+    std::mt19937 rng(11);
+    std::uniform_real_distribution<float> u01(0.0f, 1.0f);
+    int32_t *d_ids, *d_res, *h_cap, *m_cap;
+    float* d_w;
+    ck(cudaMalloc(&d_ids, strata::kernels::kEcapMaxEntries * 4), "ids");
+    ck(cudaMalloc(&d_w, strata::kernels::kEcapMaxEntries * 4), "w");
+    ck(cudaMalloc(&d_res, E * 4), "res");
+    ck(cudaHostAlloc((void**) &h_cap, 64, cudaHostAllocMapped), "cap");
+    ck(cudaHostGetDevicePointer((void**) &m_cap, h_cap, 0), "cap ptr");
+    for (int round = 0; round < 40; ++round) {
+        // a residency table: about 3 in 4 experts in VRAM (some rounds none, some all)
+        std::vector<int32_t> res(E);
+        const float p_res = round % 10 == 3 ? 0.0f : round % 10 == 7 ? 1.0f : 0.75f;
+        for (int e = 0; e < E; ++e) res[e] = u01(rng) < p_res ? e : -1;
+        ck(cudaMemcpy(d_res, res.data(), E * 4, cudaMemcpyHostToDevice), "up res");
+        // a pool of experts the window's tokens share (consecutive tokens overlap), distinct within a token
+        std::vector<int> pool(E);
+        for (int i = 0; i < E; ++i) pool[i] = i;
+        std::shuffle(pool.begin(), pool.end(), rng);
+        const int span = 14 + (int) (u01(rng) * 40);
+        for (int T : {1, 2, 3, 4, 5, 8, 12}) {
+            const int n = T * K;
+            std::vector<int32_t> ids0(n);
+            std::vector<float> w0(n);
+            for (int t = 0; t < T; ++t) {
+                std::vector<int> sub(pool.begin(), pool.begin() + span);
+                std::shuffle(sub.begin(), sub.end(), rng);
+                for (int j = 0; j < K; ++j) ids0[t * K + j] = sub[j];
+                float s = 0.0f;
+                for (int j = 0; j < K; ++j) { w0[t * K + j] = u01(rng); s += w0[t * K + j]; }
+                for (int j = 0; j < K; ++j) w0[t * K + j] /= s;
+                std::sort(w0.begin() + t * K, w0.begin() + (t + 1) * K, [](float a, float b) { return a > b; });
+            }
+            if (round % 4 == 1 && n > K + 3) { w0[K + 1] = w0[K + 2]; w0[n - 1] = w0[K + 1]; }   // ties
+            if (round % 5 == 2 && n > K + 1) ids0[n - 1] = -1;                                    // an invalid id
+            for (int cap : {0, K, K + 1, 14, 16, 20, 24, 32, 200}) {
+                std::vector<int32_t> ids_ref = ids0;
+                std::vector<float> w_ref = w0;
+                reference(ids_ref, w_ref, K, res, E, cap);
+                std::vector<int32_t> ids_a(n), ids_b(n);
+                std::vector<float> w_a(n), w_b(n);
+                for (int pass = 0; pass < 2; ++pass) {
+                    ck(cudaMemcpy(d_ids, ids0.data(), n * 4, cudaMemcpyHostToDevice), "up ids");
+                    ck(cudaMemcpy(d_w, w0.data(), n * 4, cudaMemcpyHostToDevice), "up w");
+                    *(volatile int32_t*) h_cap = cap;
+                    strata::kernels::verify_ecap(d_ids, d_w, n, K, d_res, E, m_cap, nullptr);
+                    ck(cudaDeviceSynchronize(), "sync");
+                    ck(cudaMemcpy(pass ? ids_b.data() : ids_a.data(), d_ids, n * 4, cudaMemcpyDeviceToHost), "down ids");
+                    ck(cudaMemcpy(pass ? w_b.data() : w_a.data(), d_w, n * 4, cudaMemcpyDeviceToHost), "down w");
+                }
+                ++cases;
+                const bool same = std::memcmp(ids_a.data(), ids_ref.data(), n * 4) == 0 && std::memcmp(w_a.data(), w_ref.data(), n * 4) == 0;
+                const bool det = ids_a == ids_b && std::memcmp(w_a.data(), w_b.data(), n * 4) == 0;
+                // the contract, independently of the reference
+                bool ok = same && det;
+                for (int j = 0; j < K && ok; ++j) ok = ids_a[j] == ids0[j] && w_a[j] == w0[j];
+                const bool off = cap <= K || T == 1;
+                if (off) ok = ok && ids_a == ids0 && std::memcmp(w_a.data(), w0.data(), n * 4) == 0;
+                std::set<int32_t> distinct;
+                bool any_res = false;
+                for (int j = 0; j < n; ++j) if (ids_a[j] >= 0 && !(w_a[j] == 0.0f && ids_a[j] != ids0[j])) distinct.insert(ids_a[j]);
+                for (int32_t e : distinct) any_res = any_res || res[e] >= 0;
+                if (!off) ok = ok && (int) distinct.size() <= std::max(cap, K);
+                for (int j = K; j < n && ok; ++j) {
+                    if (ids_a[j] == ids0[j] && w_a[j] == w0[j]) continue;                 // kept as routed
+                    ok = w_a[j] == 0.0f && distinct.count(ids_a[j]) == 1 && (!any_res || res[ids_a[j]] >= 0);
+                }
+                if (!ok) {
+                    ++bad;
+                    std::printf("  round %d T %d cap %d: %s%s\n", round, T, cap, same ? "" : "differs from the reference ",
+                                det ? "" : "nondeterministic");
+                }
+            }
+        }
+    }
+    cudaFree(d_ids); cudaFree(d_w); cudaFree(d_res); cudaFreeHost(h_cap);
+    if (bad) { std::printf("ecap_parity FAILED: %d of %d cases\n", bad, cases); return 1; }
+    std::printf("ecap_parity OK (%d cases)\n", cases);
+    return 0;
+}
