diff -ruN a/engine/src/kernels/cuda/verify_kernels.cu b/engine/src/kernels/cuda/verify_kernels.cu
--- a/engine/src/kernels/cuda/verify_kernels.cu
+++ b/engine/src/kernels/cuda/verify_kernels.cu
@@ -1936,6 +1936,17 @@
 __global__ void noop_kernel() {}
 }  // namespace
 void gpu_noop(void* stream) { noop_kernel<<<1, 32, 0, (cudaStream_t) stream>>>(); }
+
+// lab (CodexGame M4): a delay of known length on one stream, to read how much of it reaches the window time
+__global__ void lab_delay_kernel(unsigned long long ns) {
+    unsigned long long t0, t;
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t0));
+    do { asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t)); } while (t - t0 < ns);
+}
+
+void lab_delay_us(int us, void* stream) {
+    if (us > 0) lab_delay_kernel<<<1, 1, 0, (cudaStream_t) stream>>>((unsigned long long) us * 1000ull);
+}
 void gpu_stamp(unsigned long long* buf, int i, void* stream) {
     if (pdl_scope()) launch_pdl(gpu_stamp_kernel<true>, dim3(1), dim3(1), 0, (cudaStream_t) stream, buf, i);
     else gpu_stamp_kernel<false><<<1, 1, 0, (cudaStream_t) stream>>>(buf, i);
