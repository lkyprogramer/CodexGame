+void fill_zero(float* dst, long long n, void* stream) {
+    if (n <= 0) return;
+    if ((n & 3) != 0 || ((uintptr_t) dst & 15) != 0) {
+        std::fprintf(stderr, "fill_zero: n must be a multiple of 4 and dst 16-byte aligned\n");
