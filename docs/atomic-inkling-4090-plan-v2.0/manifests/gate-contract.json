{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qualification gate decision, separate from raw run facts",
  "type": "object",
  "required": [
    "schema_version",
    "gate",
    "status",
    "capability_key_sha256",
    "generation_id",
    "input_run_records",
    "required_test_ids",
    "evidence",
    "decision_basis",
    "reviewer",
    "authorization",
    "comparison_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "gate": {
      "enum": [
        "G0",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6",
        "G7"
      ]
    },
    "status": {
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAIL",
        "BLOCKED",
        "NO_BENEFIT"
      ]
    },
    "capability_key_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "generation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_run_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "role",
          "capability_key_sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "role": {
            "enum": [
              "candidate",
              "baseline",
              "reference",
              "inventory"
            ]
          },
          "capability_key_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "enum": [
                    "candidate",
                    "baseline",
                    "reference"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "capability_key_sha256": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "required_test_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "decision_basis": {
      "type": "string"
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "authorization": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "execution_session_reference",
        "scope",
        "authorized_at",
        "generation_id",
        "evidence"
      ],
      "properties": {
        "execution_session_reference": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "authorized_at": {
          "type": "string",
          "minLength": 1
        },
        "generation_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "comparison_contract": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "kind",
        "baseline_capability_key_sha256",
        "candidate_capability_key_sha256",
        "fixed_factors_manifest",
        "allowed_differences_manifest",
        "paired_schedule_manifest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "same_target_optimization",
            "controlled_numerical_change",
            "cross_target_product"
          ]
        },
        "baseline_capability_key_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_capability_key_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fixed_factors_manifest": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "allowed_differences_manifest": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "paired_schedule_manifest": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "capability_key_sha256": {
            "type": "string"
          },
          "generation_id": {
            "type": "string",
            "minLength": 1
          },
          "input_run_records": {
            "minItems": 1
          },
          "required_test_ids": {
            "minItems": 1
          },
          "evidence": {
            "minItems": 1
          },
          "decision_basis": {
            "type": "string",
            "minLength": 1
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate": {
            "const": "G7"
          },
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "authorization": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate": {
            "const": "G3"
          },
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "comparison_contract": {
            "type": "object"
          }
        }
      }
    }
  ]
}
