        "actual_argv",
        "exit_code",
        "kernel_symbol",
        "ptx_isa",
        "artifact_mode",
        "flags",
        "unchecked_indexing",
        "device_debug_proof_bypass"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_RUN",
            "SUCCESS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "actual_argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "kernel_symbol": {
          "type": [
            "string",
            "null"
