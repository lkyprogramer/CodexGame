    "schema_version": {
      "const": "1.0"
    },
    "record_kind": {
      "const": "kernel_candidate_facts"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "enum": [
        "K00",
        "K01",
        "K02",
        "K03",
        "K04",
        "K05",
        "K06",
        "K07"
      ]
    },
    "qualification": {
      "const": "NOT_ASSESSED"
    },
    "target_arch": {
      "const": "sm_89"
    },
    "capability_key_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "frontend": {
      "enum": [
        "UNSELECTED",
        "cuda_cpp",
        "cuda_oxide_simt",
        "cutile_rs"
      ]
    },
    "optimization_class": {
      "enum": [
        "E",
        "N"
      ]
    },
    "contract": {
      "type": "object",
      "required": [
        "shape_scope",
        "dtype_layout_scope",
        "state_effects",
        "assumptions_enforced_by"
      ],
      "properties": {
        "shape_scope": {
          "type": "array",
