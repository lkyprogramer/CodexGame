              "minimum": 0
            },
            "proved": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "failed": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "unknown": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "sorry_ax": {
