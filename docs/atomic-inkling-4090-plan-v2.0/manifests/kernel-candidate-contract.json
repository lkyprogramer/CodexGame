        "completed_event_verified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "oracle_status": {
          "enum": [
            "NOT_RUN",
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "raw_timing_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact"
