                "const": true
              },
              "unit_kind": {
                "const": "POST_MEM2REG_MIR"
              },
              "properties": {
                "minItems": 1
              },
              "assumptions": {
                "minItems": 1
              },
              "trusted_components": {
                "minItems": 1
              },
              "unproved_links": {
                "minItems": 1
