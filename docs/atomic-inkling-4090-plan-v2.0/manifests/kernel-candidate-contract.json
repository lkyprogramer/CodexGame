    "execution": {
      "type": "object",
      "required": [
        "kind",
        "status",
        "evidence_kind",
        "gpu_name",
        "gpu_uuid",
        "actual_arch",
        "driver_version",
        "kernel_launch_count",
        "completed_event_verified",
        "oracle_status",
