                "$ref": "#/$defs/artifact"
              },
              "dependency_lock": {
                "$ref": "#/$defs/artifact"
              },
              "toolchain_lock": {
                "$ref": "#/$defs/artifact"
              },
              "verified_ir": {
                "$ref": "#/$defs/artifact"
              },
              "checker_input": {
                "$ref": "#/$defs/artifact"
