        "unproved_links": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "compiler_semantics_proved": {
          "const": false
        },
        "numeric_equivalence_proved": {
          "const": false
        }
      },
      "additionalProperties": false
