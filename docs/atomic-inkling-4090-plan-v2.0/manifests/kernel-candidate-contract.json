          "build": {
            "properties": {
              "status": {
                "const": "SUCCESS"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "build": {
            "properties": {
              "artifact_mode": {
                "const": "AOT_CUBIN"
              }
            }
          },
          "artifacts": {
            "properties": {
              "tile_ir": {
                "$ref": "#/$defs/artifact"
              },
              "tile_bytecode": {
                "$ref": "#/$defs/artifact"
              },
              "tileiras": {
                "$ref": "#/$defs/artifact"
              },
              "cubin": {
                "$ref": "#/$defs/artifact"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "build": {
            "properties": {
              "status": {
                "const": "SUCCESS"
              },
              "artifact_mode": {
                "const": "AOT_CUBIN"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "properties": {
              "cubin": {
                "$ref": "#/$defs/artifact"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proof": {
            "properties": {
              "requested": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "proof": {
            "properties": {
              "status": {
                "const": "NOT_REQUESTED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proof": {
            "properties": {
              "requested": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "proof": {
            "properties": {
              "status": {
                "not": {
