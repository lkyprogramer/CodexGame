{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SM89 kernel candidate facts v1 (not a qualification decision)",
  "type": "object",
  "required": [
    "schema_version",
    "record_kind",
    "candidate_id",
    "task_id",
    "qualification",
    "target_arch",
    "capability_key_sha256",
    "target_fingerprint",
    "frontend",
    "optimization_class",
    "contract",
    "build",
    "proof",
    "execution",
    "artifacts"
  ],
