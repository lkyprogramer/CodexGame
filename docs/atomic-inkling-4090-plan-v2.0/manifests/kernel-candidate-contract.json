          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "frontend": {
            "enum": [
              "cuda_cpp",
              "cuda_oxide_simt"
            ]
          },
          "build": {
            "properties": {
              "status": {
                "const": "SUCCESS"
