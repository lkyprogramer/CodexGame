+    // Thinking and the visible answer share n_predict / max_tokens. If the
+    // client sends a small budget (common for agents), leave room so content
+    // is not empty when reasoning is cut. toast.eth / community: budget must
+    // be strictly less than the output cap.
+    if (params.n_predict > 0 && params.sampling.reasoning_budget_tokens != 0) {
+        int reserve = 256;
+        if (params.n_predict <= 64) {
+            reserve = std::max(16, params.n_predict / 2);
+        } else if (params.n_predict <= 512) {
+            reserve = std::max(64, params.n_predict / 4);
+        } else {
+            reserve = std::min(1024, std::max(256, params.n_predict / 4));
+        }
+        const int cap = std::max(0, params.n_predict - reserve);
+        int budget = params.sampling.reasoning_budget_tokens;
+        if (budget < 0 || budget > cap) {
+            params.sampling.reasoning_budget_tokens = cap;
+            SRV_INF("clamp reasoning_budget_tokens %d -> %d (n_predict=%d reserve=%d)\n",
+                    budget, cap, params.n_predict, reserve);
+        }
+    }
+
