+static const char * draft_format_for_path(const char * draft_path) {
+    std::string path(draft_path ? draft_path : "");
+    return path_ends_with(path, ".gguf") ? "gguf" : "safetensors";
+}
+
+static bool load_draft_auto(const char * draft_path, ggml_backend_t backend, DraftWeights & dw) {
+    std::string path(draft_path ? draft_path : "");
+    if (path_ends_with(path, ".gguf")) {
+        return load_draft_gguf(draft_path, backend, dw);
+    }
+    return load_draft_safetensors(draft_path, backend, dw);
+}
