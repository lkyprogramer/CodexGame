# Daily date-stamped archives. Never delete (rotate 36500 ≈ 100 years).
# copytruncate: ninfer-serve keeps an FD on ninfer-request.jsonl.
/home/hhtele/ninfer-4090/logs/ninfer-request.jsonl {
    daily
    dateext
    dateformat -%Y-%m-%d
    rotate 36500
    nocompress
    missingok
    notifempty
    copytruncate
    su hhtele hhtele
}
